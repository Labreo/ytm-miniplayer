{
  "manifest_version": 3,
  "name": "YTM Mini Mode",
  "version": "1.4.0",
  "description": "Adds a Mini Player mode to YouTube Music for multitasking.",
  "author": "Kanak Waradkar",
  "action": {
    "default_title": "Toggle Mini Player"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": ["*://music.youtube.com/*"],
  "commands": {
    "toggle-mini": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Toggle YTM Mini Player"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "js": ["browser-polyfill.min.js", "content.js"],
      "matches": ["*://music.youtube.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kakeroth222@gmail.com",
      "strict_min_version": "109.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-48.png"],
      "matches": ["*://music.youtube.com/*"]
    }
  ]
}
