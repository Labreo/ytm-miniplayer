{
  "name": "ytm-mini-mode",
  "version": "1.4.0",
  "description": "Lightweight mini-player extension for YouTube Music (Firefox & Chrome)",
  "author": "Kanak Waradkar",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.json\" \"*.md\"",
    "test": "node --test tests/**/*.test.js"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "webextension-polyfill": "^0.12.0"
  }
}
